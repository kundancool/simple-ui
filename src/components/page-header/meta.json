{
    "name": "Page Header",
    "tag": "s-page-header",
    "category": "Layout",
    "description": "Page title row with subtitle, optional add/refresh actions and an action slot.",
    "props": [
        {
            "name": "title",
            "type": "string",
            "default": "required",
            "description": "Page title."
        },
        {
            "name": "subtitle",
            "type": "string",
            "default": "''",
            "description": "Supporting line under the title."
        },
        {
            "name": "addText",
            "type": "string",
            "default": "''",
            "description": "Shows an add button with this label."
        },
        {
            "name": "loading",
            "type": "boolean",
            "default": "false",
            "description": "Refresh-button spinner state."
        },
        {
            "name": "refreshable",
            "type": "boolean",
            "default": "false",
            "description": "Shows a refresh button."
        }
    ],
    "events": [
        {
            "name": "add",
            "description": "Add button clicked."
        },
        {
            "name": "refresh",
            "description": "Refresh button clicked."
        }
    ],
    "slots": [
        {
            "name": "default",
            "description": "Extra action buttons beside add/refresh."
        }
    ],
    "example": "<s-page-header title=\"Orders\" subtitle=\"Today's activity\" add-text=\"New order\" refreshable @add=\"openCreate\" @refresh=\"reload\" />"
}
