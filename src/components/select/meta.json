{
    "name": "Select",
    "tag": "s-select",
    "category": "Form",
    "description": "Single select: native dropdown by default, searchable combobox with filterable.",
    "props": [
        {
            "name": "modelValue",
            "type": "string | number",
            "default": "''",
            "description": "Selected value (v-model)."
        },
        {
            "name": "label",
            "type": "string",
            "default": "''",
            "description": "Field label."
        },
        {
            "name": "options",
            "type": "Array",
            "default": "[]",
            "description": "Option objects."
        },
        {
            "name": "optionLabel",
            "type": "string",
            "default": "name",
            "description": "Option text key."
        },
        {
            "name": "optionValue",
            "type": "string",
            "default": "id",
            "description": "Option value key."
        },
        {
            "name": "placeholder",
            "type": "string",
            "default": "Select option",
            "description": "Placeholder."
        },
        {
            "name": "error",
            "type": "string | Array",
            "default": "''",
            "description": "Error message(s)."
        },
        {
            "name": "required",
            "type": "boolean",
            "default": "false",
            "description": "Required asterisk."
        },
        {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the field."
        },
        {
            "name": "filterable",
            "type": "boolean",
            "default": "false",
            "description": "Searchable combobox mode."
        },
        {
            "name": "clearable",
            "type": "boolean",
            "default": "false",
            "description": "Clear button."
        },
        {
            "name": "loading",
            "type": "boolean",
            "default": "false",
            "description": "Skeleton options."
        },
        {
            "name": "size",
            "type": "xs | sm | md | lg | xl | 2xl | 3xl",
            "default": "undefined",
            "description": "Control size; inherits from the form item."
        },
        {
            "name": "emptyText",
            "type": "string",
            "default": "'No matches'",
            "description": "Empty dropdown text."
        },
        {
            "name": "hint",
            "type": "string",
            "default": "''",
            "description": "Helper text under the control."
        },
        {
            "name": "inline",
            "type": "boolean",
            "default": "false",
            "description": "Deprecated no-op (roots are margin-free). Kept for compatibility."
        }
    ],
    "events": [
        {
            "name": "update:modelValue",
            "description": "v-model update."
        },
        {
            "name": "change",
            "description": "Emitted with the new value."
        },
        {
            "name": "clear",
            "description": "Emitted when the value is cleared."
        },
        {
            "name": "visible-change",
            "description": "Emitted with visibility when the dropdown opens/closes."
        }
    ],
    "slots": [],
    "example": "<s-select v-model=\"channel\" label=\"Channel\" :options=\"channels\" filterable clearable />"
}
