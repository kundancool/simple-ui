{
    "name": "Date Picker",
    "tag": "s-date-picker",
    "category": "Form",
    "description": "Themed calendar picker (single or range) built on native Date — no date library required.",
    "props": [
        {
            "name": "modelValue",
            "type": "string | Array",
            "default": "''",
            "description": "YYYY-MM-DD, or [from, to] in range mode."
        },
        {
            "name": "label",
            "type": "string",
            "default": "''",
            "description": "Field label."
        },
        {
            "name": "placeholder",
            "type": "string",
            "default": "Select date",
            "description": "Placeholder."
        },
        {
            "name": "range",
            "type": "boolean",
            "default": "false",
            "description": "Range mode."
        },
        {
            "name": "min",
            "type": "string",
            "default": "''",
            "description": "Earliest selectable date."
        },
        {
            "name": "max",
            "type": "string",
            "default": "''",
            "description": "Latest selectable date."
        },
        {
            "name": "options",
            "type": "Array",
            "default": "null",
            "description": "Shortcut override: [{ label, value }] or [{ label, range: [from, to] }] as YYYY-MM-DD. No options unless defined. Bad entries are ignored."
        },
        {
            "name": "presets",
            "type": "Array",
            "default": "[]",
            "description": "Deprecated alias of `options`."
        },
        {
            "name": "error",
            "type": "string | Array",
            "default": "''",
            "description": "Error message(s)."
        },
        {
            "name": "hint",
            "type": "string",
            "default": "''",
            "description": "Helper text."
        },
        {
            "name": "required",
            "type": "boolean",
            "default": "false",
            "description": "Required asterisk."
        },
        {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the field."
        },
        {
            "name": "name",
            "type": "string",
            "default": "''",
            "description": "Native input name so the date joins form submission."
        },
        {
            "name": "size",
            "type": "xs | sm | md | lg | xl | 2xl | 3xl",
            "default": "undefined",
            "description": "Control size; inherits from the form item."
        },
        {
            "name": "format",
            "type": "string",
            "default": "YYYY-MM-DD",
            "description": "Trigger display format."
        },
        {
            "name": "columns",
            "type": "number",
            "default": "range ? 2 : 1",
            "description": "Visible month columns; stacks on narrow screens."
        },
        {
            "name": "valueFormat",
            "type": "string",
            "default": "'YYYY-MM-DD'",
            "description": "Emitted value format (same YYYY/MM/DD tokens). Display stays on format."
        },
        {
            "name": "disabledDate",
            "type": "Function",
            "default": "null",
            "description": "Disable rule: (date: Date) => true disables that day."
        },
        {
            "name": "disabledRanges",
            "type": "Array",
            "default": "[]",
            "description": "Disable rule: [[from, to]] as YYYY-MM-DD disables those ranges."
        },
        {
            "name": "inline",
            "type": "boolean",
            "default": "false",
            "description": "Deprecated no-op (roots are margin-free). Kept for compatibility."
        }
    ],
    "events": [
        {
            "name": "update:modelValue",
            "description": "v-model update."
        },
        {
            "name": "change",
            "description": "Emitted with the new value."
        }
    ],
    "slots": [],
    "example": "<s-date-picker v-model=\"from\" label=\"From\" />\n<s-date-picker v-model=\"period\" range label=\"Date range\" />"
}
