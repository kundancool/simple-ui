{
    "name": "Doughnut Chart",
    "tag": "s-doughnut-chart",
    "category": "Charts",
    "description": "Responsive doughnut chart with themed defaults. Requires chart.js + vue-chartjs.",
    "props": [
        {
            "name": "labels",
            "type": "Array",
            "default": "[]",
            "description": "Segment labels."
        },
        {
            "name": "datasets",
            "type": "Array",
            "default": "[]",
            "description": "Chart.js datasets."
        },
        {
            "name": "options",
            "type": "object",
            "default": "{}",
            "description": "Deep-overrides for the default options."
        },
        {
            "name": "height",
            "type": "number",
            "default": "260",
            "description": "Canvas height px."
        }
    ],
    "events": [],
    "slots": [
        {
            "name": "empty",
            "description": "Shown when labels are empty."
        }
    ],
    "example": "<s-doughnut-chart :labels=\"['Paid', 'Outstanding']\" :datasets=\"[{ data: [paid, due], backgroundColor: ['#12853d', '#b45309'] }]\" />"
}
