{
    "name": "Line Chart",
    "tag": "s-line-chart",
    "category": "Charts",
    "description": "Responsive line chart with themed defaults. Requires chart.js + vue-chartjs.",
    "props": [
        {
            "name": "labels",
            "type": "Array",
            "default": "[]",
            "description": "X-axis labels."
        },
        {
            "name": "datasets",
            "type": "Array",
            "default": "[]",
            "description": "Chart.js datasets."
        },
        {
            "name": "options",
            "type": "object",
            "default": "{}",
            "description": "Deep-overrides for the default options."
        },
        {
            "name": "height",
            "type": "number",
            "default": "260",
            "description": "Canvas height px."
        }
    ],
    "events": [],
    "slots": [
        {
            "name": "empty",
            "description": "Shown when labels are empty."
        }
    ],
    "example": "<s-line-chart :labels=\"['Mon', 'Tue', 'Wed']\" :datasets=\"[{ label: 'Revenue', data: [12, 19, 8], borderColor: '#0c7076', tension: 0.4 }]\" />"
}
