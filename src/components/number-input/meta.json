{
    "name": "Number Input",
    "tag": "s-number-input",
    "category": "Form",
    "description": "Numeric stepper with +/- buttons, min/max clamping and validation error.",
    "props": [
        {
            "name": "modelValue",
            "type": "number | string",
            "default": "0",
            "description": "Value (v-model)."
        },
        {
            "name": "label",
            "type": "string",
            "default": "''",
            "description": "Field label."
        },
        {
            "name": "placeholder",
            "type": "string",
            "default": "''",
            "description": "Placeholder."
        },
        {
            "name": "min",
            "type": "number",
            "default": "0",
            "description": "Minimum value."
        },
        {
            "name": "max",
            "type": "number",
            "default": "Infinity",
            "description": "Maximum value."
        },
        {
            "name": "stepBy",
            "type": "number",
            "default": "1",
            "description": "Step increment."
        },
        {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the control."
        },
        {
            "name": "required",
            "type": "boolean",
            "default": "false",
            "description": "Required asterisk."
        },
        {
            "name": "error",
            "type": "string | Array",
            "default": "''",
            "description": "Error message(s)."
        },
        {
            "name": "hint",
            "type": "string",
            "default": "''",
            "description": "Helper text."
        },
        {
            "name": "wrapper",
            "type": "block | inline",
            "default": "block",
            "description": "Spacing layout."
        }
    ],
    "events": [
        {
            "name": "update:modelValue",
            "description": "v-model update."
        },
        {
            "name": "change",
            "description": "Emitted with the clamped value."
        }
    ],
    "slots": [],
    "example": "<s-number-input v-model=\"quantity\" label=\"Quantity\" :min=\"1\" :max=\"6\" />"
}
