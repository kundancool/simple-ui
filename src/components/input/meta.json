{
    "name": "Input",
    "tag": "s-input",
    "category": "Form",
    "description": "Labelled text input / textarea with validation error, hint and a trailing action slot.",
    "props": [
        {
            "name": "modelValue",
            "type": "string | number",
            "default": "''",
            "description": "Field value (v-model)."
        },
        {
            "name": "label",
            "type": "string",
            "default": "''",
            "description": "Field label."
        },
        {
            "name": "type",
            "type": "string",
            "default": "text",
            "description": "Input type or textarea. Dates: use SDatePicker."
        },
        {
            "name": "placeholder",
            "type": "string",
            "default": "''",
            "description": "Placeholder text."
        },
        {
            "name": "error",
            "type": "string | Array",
            "default": "''",
            "description": "Error message(s); first wins."
        },
        {
            "name": "hint",
            "type": "string",
            "default": "''",
            "description": "Helper text when no error."
        },
        {
            "name": "required",
            "type": "boolean",
            "default": "false",
            "description": "Shows the required asterisk."
        },
        {
            "name": "disabled",
            "type": "boolean",
            "default": "false",
            "description": "Disables the field."
        },
        {
            "name": "rows",
            "type": "number",
            "default": "4",
            "description": "Textarea rows."
        },
        {
            "name": "min",
            "type": "string | number",
            "default": "null",
            "description": "Min attribute."
        },
        {
            "name": "max",
            "type": "string",
            "default": "null",
            "description": "Max attribute."
        },
        {
            "name": "size",
            "type": "xs | sm | md | lg | xl | 2xl | 3xl",
            "default": "undefined",
            "description": "Control size; inherits from the form item."
        },
        {
            "name": "clearable",
            "type": "boolean",
            "default": "false",
            "description": "Clear button when there is a value."
        },
        {
            "name": "maxlength",
            "type": "string | number",
            "default": "null",
            "description": "Max length attribute."
        },
        {
            "name": "readonly",
            "type": "boolean",
            "default": "false",
            "description": "Readonly state."
        },
        {
            "name": "showWordLimit",
            "type": "boolean",
            "default": "false",
            "description": "Character counter with maxlength."
        },
        {
            "name": "inline",
            "type": "boolean",
            "default": "false",
            "description": "Deprecated no-op (roots are margin-free). Kept for compatibility."
        }
    ],
    "events": [
        {
            "name": "update:modelValue",
            "description": "v-model update."
        },
        {
            "name": "input",
            "description": "Emitted on every keystroke with the value."
        },
        {
            "name": "change",
            "description": "Emitted on change with the value."
        },
        {
            "name": "blur",
            "description": "Emitted on blur with the FocusEvent."
        },
        {
            "name": "focus",
            "description": "Emitted on focus with the FocusEvent."
        },
        {
            "name": "clear",
            "description": "Emitted when the clear button empties the field."
        },
        {
            "name": "toggle-visibility",
            "description": "Emitted with visibility after password reveal toggle."
        }
    ],
    "slots": [
        {
            "name": "trailing",
            "description": "Action beside the label."
        },
        {
            "name": "prefix",
            "description": "Leading adornment inside the field."
        },
        {
            "name": "suffix",
            "description": "Trailing adornment inside the field."
        }
    ],
    "example": "<s-input v-model=\"name\" label=\"Customer name\" placeholder=\"Full name\" :error=\"errors.name\" required />"
}
