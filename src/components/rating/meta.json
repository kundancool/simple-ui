{
    "name": "Rating",
    "tag": "s-rating",
    "category": "Form",
    "description": "Star rating input or read-only display with hover preview.",
    "props": [
        { "name": "modelValue", "type": "number", "default": "0", "description": "Rating value (v-model)." },
        { "name": "max", "type": "number", "default": "5", "description": "Star count." },
        { "name": "readonly", "type": "boolean", "default": "false", "description": "Display only." },
        { "name": "disabled", "type": "boolean", "default": "false", "description": "Disables input." },
        { "name": "size", "type": "sm | md | lg", "default": "md", "description": "Star size." },
        { "name": "color", "type": "warning | accent", "default": "warning", "description": "Lit star color." },
        { "name": "ariaLabel", "type": "string", "default": "Rating", "description": "Accessible label." }
    ],
    "events": [
        { "name": "update:modelValue", "description": "v-model update." },
        { "name": "change", "description": "Emitted with the new rating." }
    ],
    "slots": [],
    "example": "<s-rating v-model=\"score\" />\n<s-rating :model-value=\"4.8\" readonly size=\"sm\" />"
}
