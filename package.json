{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@kundancool/simple-ui",
    "version": "0.1.0",
    "description": "Simple UI — lightweight Vue 3 component library with S-prefixed components (s-input, s-button, s-dialog…) that coexist with Element Plus.",
    "type": "module",
    "license": "MIT",
    "author": "Kundan",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kundancool/simple-ui.git"
    },
    "homepage": "https://kundancool.github.io/simple-ui/",
    "keywords": [
        "vue",
        "vue3",
        "ui",
        "components",
        "element-plus",
        "dashboard",
        "simple-ui"
    ],
    "main": "./dist/simple-ui.umd.cjs",
    "module": "./dist/simple-ui.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/simple-ui.umd.cjs",
    "jsdelivr": "./dist/simple-ui.umd.cjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/simple-ui.js",
            "default": "./dist/simple-ui.umd.cjs"
        },
        "./dist/simple-ui.css": "./dist/simple-ui.css",
        "./styles/tokens.css": "./dist/styles/tokens.css",
        "./resolver": {
            "types": "./dist/resolver.d.ts",
            "import": "./dist/resolver.js"
        },
        "./components/*": {
            "types": "./dist/components/*/index.d.ts",
            "import": "./dist/components/*/index.js"
        },
        "./registry.json": "./dist/registry.json",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "*.css"
    ],
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "llms.txt",
        "README.md"
    ],
    "scripts": {
        "build": "npm run build:lib && npm run build:registry",
        "build:lib": "vite build && vite build --config vite.resolver.config.ts && vite build --config vite.components.config.ts && node scripts/link-component-css.mjs && node scripts/copy-styles.mjs",
        "watch:lib": "vite build --watch",
        "build:registry": "node scripts/build-registry.mjs",
        "build:docs": "node scripts/link-self.mjs && npm run build && vite build --config vite.docs.config.ts",
        "preview:docs": "vite preview --config vite.docs.config.ts --port 5199",
        "dev:docs": "node scripts/link-self.mjs && vite --config vite.docs.config.ts",
        "dev": "node scripts/link-self.mjs && concurrently -n lib,docs -c green,cyan \"npm run watch:lib\" \"vite --config vite.docs.config.ts\"",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "prepublishOnly": "npm run build",
        "postinstall": "node scripts/link-self.mjs"
    },
    "peerDependencies": {
        "chart.js": "^4.0.0",
        "vue": "^3.5.0",
        "vue-chartjs": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "chart.js": {
            "optional": true
        },
        "vue-chartjs": {
            "optional": true
        }
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.17.0",
        "@tailwindcss/vite": "^4.2.2",
        "@types/node": "^22.20.2",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vue/test-utils": "^2.4.11",
        "chart.js": "^4.5.1",
        "concurrently": "^10.0.5",
        "jsdom": "^29.0.0",
        "lucide-vue-next": "^1.0.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^5.6.0",
        "vite": "^8.0.1",
        "vite-plugin-dts": "^4.5.0",
        "vitest": "^3.0.0",
        "vue": "^3.5.30",
        "vue-chartjs": "^5.3.3",
        "vue-tsc": "^2.2.0"
    }
}
