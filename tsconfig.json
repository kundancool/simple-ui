{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": false,
        "allowJs": true,
        "checkJs": false,
        "jsx": "preserve",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node"]
    },
    "include": ["src/**/*", "docs/**/*", "tests/**/*", "scripts/**/*"],
    "exclude": ["node_modules", "dist", "docs-dist"]
}
